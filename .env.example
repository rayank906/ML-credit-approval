# Supabase PostgreSQL — Transaction Pooler (IPv4 compatible)
# Get this from: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Random secret for signing JWT tokens (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-random-hex-string

# Redis (job queue)
REDIS_URL=redis://localhost:6379/0
JOB_QUEUE_NAME=ml_jobs
